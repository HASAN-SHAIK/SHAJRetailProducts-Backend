# ========================================
# Runtime
# ========================================
APP_ENVIRONMENT=development
APP_PORT=5001

# Temporary legacy aliases used by older scripts/code paths.
NODE_ENV=development
PORT=5001

# ========================================
# PostgreSQL - Master/Admin
# ========================================
MASTER_DATABASE_URL=
ADMIN_DATABASE_URL=
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=platform_db
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=postgres
ADMIN_DB_POOL_MAX=
MASTER_DB_POOL_MAX=

# ========================================
# PostgreSQL - Tenants
# ========================================
TENANT_DATABASE_URL_TEMPLATE=
TENANT_DB_HOST=
TENANT_DB_PORT=
TENANT_DB_USER=
TENANT_DB_PASSWORD=
TENANT_DB_POOL_MAX=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=
DB_SSL=false

# ========================================
# Auth
# ========================================
JWT_SECRET=replace-me
ADMIN_JWT_SECRET=replace-me-admin
ACCESS_TOKEN_EXPIRY=15m
ADMIN_TOKEN_EXPIRY=14400
TOKEN_COOKIE_MAX_AGE_MS=28800000
ADMIN_TOKEN_COOKIE_MAX_AGE_MS=14400000
REFRESH_TOKEN_TTL_MS=28800000
REFRESH_TOKEN_REMEMBER_MS=2592000000
ACCESS_TOKEN_MAX_AGE_MS=

# ========================================
# Offline Grant Cryptography (RS256)
# ========================================
# Central signs offline cashier and sync recovery grants using this RSA private key (PKCS#8 PEM).
# Never commit this private key or expose it to frontend bundles.
POS_OFFLINE_GRANT_PRIVATE_KEY=
POS_OFFLINE_GRANT_PUBLIC_KEY=
POS_OFFLINE_GRANT_KEY_ID=pos-offline-v2
POS_OFFLINE_GRANT_EXPIRY=7d
POS_SYNC_RECOVERY_GRANT_EXPIRY=10m

# ========================================
# POS Sync Ingress
# ========================================
POS_SYNC_TENANT_ID=tenant-dev
POS_SYNC_TOKEN=change-me
POS_SYNC_TOKENS_JSON=

# ========================================
# CORS and Frontend Origins
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4173
FRONTEND_ADMIN_URL=
FRONTEND_TENANT_URL=

# ========================================
# Health and Observability
# ========================================
HEALTH_WARMUP_KEY=
HEALTH_WARMUP_WINDOW_ENABLED=false
HEALTH_WARMUP_TZ_OFFSET_MINUTES=330
HEALTH_WARMUP_START_HOUR=0
HEALTH_WARMUP_START_MINUTE=0
HEALTH_WARMUP_END_HOUR=23
HEALTH_WARMUP_END_MINUTE=59
API_LOG_LEVEL=info
DB_LOG_TIMING=false
DB_LOG_CONNECT_TIMING=false
DB_LOG_TIMING_THRESHOLD_MS=0
DB_LOG_TIMING_QUERY_MAX_LEN=200
DB_WARMUP_ENABLED=false
DB_WARMUP_INTERVAL_MS=240000
TENANT_POOL_IDLE_EVICT_MS=900000
TENANT_POOL_IDLE_SWEEP_MS=300000

# ========================================
# Background Jobs
# ========================================
OWNER_DIGEST_JOB_ENABLED=true
OWNER_DIGEST_JOB_MS=300000
OWNER_DIGEST_DEFAULT_TZ=Asia/Kolkata
OWNER_DIGEST_DEFAULT_TIME=09:00
OWNER_DIGEST_DEFAULT_LOW_STOCK_THRESHOLD=5
STOCK_CONSISTENCY_JOB_ENABLED=true
STOCK_CONSISTENCY_JOB_MS=300000

# ========================================
# RabbitMQ Sync Infrastructure
# ========================================
RABBITMQ_SYNC_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10
RABBITMQ_SYNC_MAX_RETRIES=5
RABBITMQ_SYNC_RETRY_DELAY_MS=30000
RABBITMQ_SYNC_EXCHANGE=shaj.sync
RABBITMQ_SYNC_RETRY_EXCHANGE=shaj.sync.retry
RABBITMQ_SYNC_DLX_EXCHANGE=shaj.sync.dlx
RABBITMQ_SYNC_QUEUE=shaj.sync.operations
RABBITMQ_SYNC_RETRY_QUEUE=shaj.sync.retry
RABBITMQ_SYNC_DLQ=shaj.sync.dlq
RABBITMQ_SYNC_ROUTING_KEY=sync.operation

# ========================================
# External Services
# ========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_CASE_INTAKE_EMAIL=support@example.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_BASE_URL=

# ========================================
# Bootstrap and Seed
# ========================================
PLATFORM_BOOTSTRAP_EMAIL=admin@example.com
PLATFORM_BOOTSTRAP_PASSWORD=change-me
PLATFORM_BOOTSTRAP_NAME=Platform Admin
PLATFORM_BOOTSTRAP_ROLE=platform_admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME=Platform Admin
ADMIN_SEED_ROLE=platform_admin
